#!/bin/bash
# dots - wrapper for dots.py (global)
DOTS_DIR="$(cd "$(dirname "$0")" && pwd)"
# Instructions may live alongside the dotS install (e.g. ~/.config/opencode/instructions)
if [ -z "$S_INSTRUCTIONS_DIR" ] && [ -d "$DOTS_DIR/../instructions" ]; then
  export S_INSTRUCTIONS_DIR="$(cd "$DOTS_DIR/../instructions" && pwd)"
fi
exec python3 "$DOTS_DIR/dots.py" "$@"
